---
/**
 * Say it out loud, against a clock.
 *
 * Knowing a thing and being able to explain it in ninety seconds to a stranger
 * who is judging you are different skills, and only the second one gets you
 * hired. Reading the model answer silently does not build it — the timer and
 * the speaking are the exercise, the text is just the marking scheme.
 */
import { inline } from '../../lib/inline';

interface Props {
  step: string;
  id: string;
  /** The question, as an interviewer would say it. */
  question: string;
  seconds?: number;
  /** Points a good answer hits. Shown after the attempt. */
  hits: string[];
  /** The common way candidates get this wrong. */
  trap?: string;
}

const { step, id, question, seconds = 90, hits, trap } = Astro.props;
const key = `${step}::drill::${id}`;
---
<section class="my-6 rounded-xl border p-4" data-drill={key} data-seconds={seconds} style="background: var(--surface-2); border-color: var(--rule)">
  <p class="eyebrow" style="color: var(--accent)">🎙 Drill · say it out loud</p>
  <p class="mt-1.5 text-[1rem] font-semibold leading-snug">“{question}”</p>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button class="btn text-[0.75rem]" data-drill-start>Start {seconds}s</button>
    <span class="font-mono text-[1.05rem] tabular-nums" data-drill-clock style="color: var(--text-3)">
      {Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, '0')}
    </span>
    <button class="btn ml-auto text-[0.73rem]" data-drill-show>Show marking scheme</button>
  </div>

  <div class="mt-4 hidden" data-drill-scheme>
    <p class="eyebrow">A good answer hits</p>
    <ul class="mt-1.5 space-y-1">
      {hits.map((h) => (
        <li class="flex gap-2 text-[0.89rem] leading-snug">
          <span style="color: var(--ok)" aria-hidden="true">✓</span>
          <span set:html={inline(h)} />
        </li>
      ))}
    </ul>

    {trap && (
      <p class="mt-3 rounded-lg p-2.5 text-[0.86rem] leading-relaxed" style="background: var(--bad-soft); color: var(--text-2)">
        <span class="font-semibold" style="color: var(--bad)">Common trap:</span> <span set:html={inline(trap)} />
      </p>
    )}

    <div class="mt-3 flex flex-wrap gap-2">
      <button class="btn text-[0.72rem]" data-grade="0">Fumbled</button>
      <button class="btn text-[0.72rem]" data-grade="1">Got there</button>
      <button class="btn text-[0.72rem]" data-grade="2">Fluent</button>
    </div>
  </div>
</section>

<script>
  import { saveAttempt, getAttempt } from '../../lib/track-store';

  for (const drill of document.querySelectorAll<HTMLElement>('[data-drill]')) {
    const key = drill.dataset.drill!;
    const total = Number(drill.dataset.seconds);
    const clock = drill.querySelector<HTMLElement>('[data-drill-clock]')!;
    const startBtn = drill.querySelector<HTMLButtonElement>('[data-drill-start]')!;
    const showBtn = drill.querySelector<HTMLButtonElement>('[data-drill-show]')!;
    const scheme = drill.querySelector<HTMLElement>('[data-drill-scheme]')!;

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

    const paint = (grade: number | null) => {
      for (const b of drill.querySelectorAll<HTMLButtonElement>('[data-grade]')) {
        const on = Number(b.dataset.grade) === grade;
        b.style.background = on ? 'var(--accent)' : '';
        b.style.color = on ? '#fff' : '';
      }
    };

    const prev = getAttempt(key);
    if (prev?.grade !== null && prev?.grade !== undefined) {
      scheme.classList.remove('hidden');
      paint(prev.grade);
    }

    let timer: ReturnType<typeof setInterval> | null = null;
    startBtn.addEventListener('click', () => {
      if (timer) clearInterval(timer);
      let left = total;
      clock.textContent = fmt(left);
      clock.style.color = 'var(--accent)';
      startBtn.disabled = true;
      timer = setInterval(() => {
        left -= 1;
        clock.textContent = fmt(Math.max(left, 0));
        if (left <= 0) {
          clearInterval(timer!);
          clock.style.color = 'var(--bad)';
          startBtn.disabled = false;
          startBtn.textContent = 'Again';
          scheme.classList.remove('hidden');
        }
      }, 1000);
    });

    showBtn.addEventListener('click', () => scheme.classList.toggle('hidden'));

    for (const b of drill.querySelectorAll<HTMLButtonElement>('[data-grade]')) {
      b.addEventListener('click', () => {
        const g = Number(b.dataset.grade) as 0 | 1 | 2;
        saveAttempt(key, '', g);
        paint(g);
      });
    }
  }
</script>
