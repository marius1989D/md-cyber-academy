---
/**
 * The honesty check at the end of a step.
 *
 * Gates are self-assessed and not enforced — locking content would just teach
 * you to route around it. What they do is make "I sort of covered that" hard
 * to say to yourself, which is the failure mode that produces candidates who
 * interview badly on material they genuinely read.
 */
import { inline } from '../../lib/inline';

interface Props {
  step: string;
  /** Conditions that must be true before moving on. */
  conditions: string[];
  /** What the next step assumes you can now do. */
  unlocks?: string;
}

const { step, conditions, unlocks } = Astro.props;
---
<section
  class="my-8 rounded-xl border-2 p-4 sm:p-5"
  data-gate={`${step}::gate`}
  style="border-color: var(--gold, #b8860b); background: var(--surface-2)"
>
  <header class="flex items-center justify-between gap-4">
    <p class="eyebrow" style="color: var(--gold, #b8860b)">🔒 Gate</p>
    <p class="font-mono text-[0.7rem]" style="color: var(--text-3)">
      <span data-gate-count>0</span> / {conditions.length}
    </p>
  </header>

  <p class="mt-1.5 text-[0.88rem]" style="color: var(--text-3)">
    Tick these only if they are true. Nobody is checking, which is exactly why it counts.
  </p>

  <ul class="mt-3 space-y-1">
    {conditions.map((c, i) => (
      <li>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg px-2.5 py-2 hover:bg-[var(--surface-3)]">
          <input
            type="checkbox"
            class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-[var(--gold,#b8860b)]"
            data-gate-cond={`${step}::gate::${i}`}
          />
          <span class="text-[0.92rem] leading-snug" set:html={inline(c)} />
        </label>
      </li>
    ))}
  </ul>

  <div class="mt-4 hidden rounded-lg p-3" data-gate-pass style="background: var(--ok-soft)">
    <p class="text-[0.9rem] font-semibold" style="color: var(--ok)">✓ Gate cleared</p>
    {unlocks && (
      <p class="mt-1 text-[0.86rem]" style="color: var(--text-2)">{unlocks}</p>
    )}
  </div>
</section>

<script>
  import { toggleTask, isDone } from '../../lib/track-store';

  for (const gate of document.querySelectorAll<HTMLElement>('[data-gate]')) {
    const boxes = gate.querySelectorAll<HTMLInputElement>('[data-gate-cond]');
    const count = gate.querySelector<HTMLElement>('[data-gate-count]');
    const pass = gate.querySelector<HTMLElement>('[data-gate-pass]');

    const paint = () => {
      const done = [...boxes].filter((b) => b.checked).length;
      if (count) count.textContent = String(done);
      pass?.classList.toggle('hidden', done !== boxes.length);
    };

    for (const box of boxes) {
      box.checked = isDone(box.dataset.gateCond!);
      box.addEventListener('change', () => {
        toggleTask(box.dataset.gateCond!, box.checked);
        paint();
      });
    }
    paint();
  }
</script>
