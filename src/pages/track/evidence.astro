---
import Base from '../../layouts/Base.astro';
---

<Base title="Evidence & Applications" description="Artifacts produced and jobs applied for.">
  <header class="border-b pb-6">
    <p class="eyebrow" style="color: var(--accent)">// Track 6</p>
    <h1 class="mt-2 text-[clamp(1.7rem,1.3rem+1.8vw,2.4rem)]">Evidence & Applications</h1>
    <p class="mt-3 max-w-[60ch] text-[1rem]" style="color: var(--text-2)">
      Two lists that decide whether ten months of study turns into a job.
      Every row in the first becomes a line on your CV. Every row in the second
      is a chance you actually took.
    </p>
  </header>

  <!-- ── Evidence ─────────────────────────────────────────────────── -->
  <section class="mt-9">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-xl">Evidence log</h2>
      <p class="font-mono text-[0.72rem]" style="color: var(--text-3)">
        <span data-ev-count>0</span> artifacts
      </p>
    </div>
    <p class="mt-1 text-[0.9rem]" style="color: var(--text-3)">
      Log it the day you finish it. Detail you don't write down is detail you
      won't remember in an interview six months later.
    </p>

    <form class="panel mt-4 grid gap-3 p-4 sm:grid-cols-2" data-ev-form>
      <label class="block">
        <span class="eyebrow">Title</span>
        <input required name="title" placeholder="Sentinel detection for encoded PowerShell" class="fld" />
      </label>
      <label class="block">
        <span class="eyebrow">Step</span>
        <input name="step" placeholder="05-lab/03-write-detections" class="fld" />
      </label>
      <label class="block sm:col-span-2">
        <span class="eyebrow">Link</span>
        <input name="url" type="url" placeholder="https://github.com/..." class="fld" />
      </label>
      <label class="block sm:col-span-2">
        <span class="eyebrow">What it proves — write this as a CV bullet</span>
        <textarea name="note" rows="2" placeholder="Wrote and tuned a KQL analytics rule; cut false positives from 40/day to 2 by excluding signed installer parents." class="fld"></textarea>
      </label>
      <div class="sm:col-span-2">
        <button type="submit" class="btn text-[0.78rem]">Add evidence</button>
      </div>
    </form>

    <ul class="mt-4 space-y-2" data-ev-list></ul>
  </section>

  <!-- ── Applications ─────────────────────────────────────────────── -->
  <section class="mt-12">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-xl">Application tracker</h2>
      <p class="font-mono text-[0.72rem]" style="color: var(--text-3)" data-app-stats></p>
    </div>
    <p class="mt-1 text-[0.9rem]" style="color: var(--text-3)">
      Rejection rate at entry level is brutal and says very little about you.
      Tracking it turns a demoralising blur into a number you can work on.
    </p>

    <form class="panel mt-4 grid gap-3 p-4 sm:grid-cols-2" data-app-form>
      <label class="block">
        <span class="eyebrow">Company</span>
        <input required name="company" placeholder="Quorum Cyber" class="fld" />
      </label>
      <label class="block">
        <span class="eyebrow">Role</span>
        <input required name="role" placeholder="SOC Analyst L1" class="fld" />
      </label>
      <label class="block">
        <span class="eyebrow">Applied</span>
        <input name="applied" type="date" class="fld" />
      </label>
      <label class="block">
        <span class="eyebrow">Status</span>
        <select name="status" class="fld">
          <option value="applied">Applied</option>
          <option value="screening">Screening</option>
          <option value="interview">Interview</option>
          <option value="offer">Offer</option>
          <option value="rejected">Rejected</option>
          <option value="ghosted">Ghosted</option>
        </select>
      </label>
      <label class="block sm:col-span-2">
        <span class="eyebrow">Notes</span>
        <input name="note" placeholder="Referred by X · asked about KQL and Sysmon event 1" class="fld" />
      </label>
      <div class="sm:col-span-2">
        <button type="submit" class="btn text-[0.78rem]">Add application</button>
      </div>
    </form>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-[0.88rem]">
        <thead>
          <tr class="border-b" style="color: var(--text-3)">
            <th class="py-2 pr-3 font-mono text-[0.66rem] uppercase tracking-wider">Company</th>
            <th class="py-2 pr-3 font-mono text-[0.66rem] uppercase tracking-wider">Role</th>
            <th class="py-2 pr-3 font-mono text-[0.66rem] uppercase tracking-wider">Status</th>
            <th class="py-2 font-mono text-[0.66rem] uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody data-app-list></tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .fld {
    margin-top: 0.35rem;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--text);
    padding: 0.55rem 0.7rem;
    font-size: 0.88rem;
  }
  .fld:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
</style>

<script>
  import {
    addEvidence, listEvidence, removeEvidence,
    addApplication, listApplications, updateApplication, removeApplication,
  } from '../../lib/track-store';

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  /* ── Evidence ─────────────────────────────────────────────────── */
  const evList = document.querySelector<HTMLElement>('[data-ev-list]')!;
  const evCount = document.querySelector<HTMLElement>('[data-ev-count]')!;

  function renderEvidence() {
    const items = listEvidence();
    evCount.textContent = String(items.length);
    evList.innerHTML =
      items.length === 0
        ? `<li class="panel p-5 text-center text-[0.88rem]" style="color: var(--text-3)">
             Nothing logged yet. The first entry usually arrives at the end of Phase 5, step 1.
           </li>`
        : items
            .map(
              (e) => `
        <li class="panel p-3.5" data-ev="${e.id}">
          <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <p class="text-[0.94rem] font-semibold leading-snug">
                ${e.url ? `<a href="${esc(e.url)}" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-2">${esc(e.title)}</a>` : esc(e.title)}
              </p>
              ${e.note ? `<p class="mt-1 text-[0.85rem] leading-relaxed" style="color: var(--text-2)">${esc(e.note)}</p>` : ''}
              <p class="mt-1 font-mono text-[0.64rem]" style="color: var(--text-3)">
                ${esc(e.step || '—')} · ${new Date(e.at).toLocaleDateString('en-GB')}
              </p>
            </div>
            <button class="btn shrink-0 px-2 py-1 text-[0.7rem]" data-ev-del="${e.id}" aria-label="Delete">✕</button>
          </div>
        </li>`,
            )
            .join('');
  }

  document.querySelector<HTMLFormElement>('[data-ev-form]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const d = new FormData(f);
    addEvidence({
      title: String(d.get('title') ?? ''),
      step: String(d.get('step') ?? ''),
      url: String(d.get('url') ?? ''),
      note: String(d.get('note') ?? ''),
    });
    f.reset();
    renderEvidence();
  });

  evList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-ev-del]');
    if (!btn) return;
    removeEvidence(btn.dataset.evDel!);
    renderEvidence();
  });

  /* ── Applications ─────────────────────────────────────────────── */
  const appList = document.querySelector<HTMLElement>('[data-app-list]')!;
  const appStats = document.querySelector<HTMLElement>('[data-app-stats]')!;
  const STATUSES = ['applied', 'screening', 'interview', 'offer', 'rejected', 'ghosted'];
  const COLOUR: Record<string, string> = {
    applied: 'var(--text-3)',
    screening: 'var(--gold, #b8860b)',
    interview: 'var(--accent)',
    offer: 'var(--ok)',
    rejected: 'var(--bad)',
    ghosted: 'var(--text-3)',
  };

  function renderApps() {
    const items = listApplications();
    const live = items.filter((a) => ['applied', 'screening', 'interview'].includes(a.status)).length;
    const interviews = items.filter((a) => ['interview', 'offer'].includes(a.status)).length;
    appStats.textContent = items.length
      ? `${items.length} sent · ${live} live · ${interviews} to interview (${Math.round((interviews / items.length) * 100)}%)`
      : '';

    appList.innerHTML =
      items.length === 0
        ? `<tr><td colspan="4" class="py-6 text-center text-[0.88rem]" style="color: var(--text-3)">
             No applications yet. Phase 7 opens around week 28 — but apply the moment the readiness gate clears.
           </td></tr>`
        : items
            .map(
              (a) => `
        <tr class="border-b" data-app="${a.id}">
          <td class="py-2.5 pr-3 font-medium">${esc(a.company)}</td>
          <td class="py-2.5 pr-3" style="color: var(--text-2)">
            ${esc(a.role)}
            ${a.note ? `<span class="block font-mono text-[0.64rem]" style="color: var(--text-3)">${esc(a.note)}</span>` : ''}
          </td>
          <td class="py-2.5 pr-3">
            <select data-app-status="${a.id}" class="rounded border px-1.5 py-1 text-[0.78rem]"
              style="background: var(--surface); border-color: var(--rule); color: ${COLOUR[a.status]}">
              ${STATUSES.map((s) => `<option value="${s}"${s === a.status ? ' selected' : ''}>${s[0].toUpperCase() + s.slice(1)}</option>`).join('')}
            </select>
          </td>
          <td class="py-2.5 text-right">
            <button class="btn px-2 py-1 text-[0.7rem]" data-app-del="${a.id}" aria-label="Delete">✕</button>
          </td>
        </tr>`,
            )
            .join('');
  }

  document.querySelector<HTMLFormElement>('[data-app-form]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const d = new FormData(f);
    addApplication({
      company: String(d.get('company') ?? ''),
      role: String(d.get('role') ?? ''),
      applied: String(d.get('applied') ?? ''),
      status: (d.get('status') as never) ?? 'applied',
      note: String(d.get('note') ?? ''),
    });
    f.reset();
    renderApps();
  });

  appList.addEventListener('change', (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-app-status]');
    if (!sel) return;
    updateApplication(sel.dataset.appStatus!, { status: sel.value as never });
    renderApps();
  });

  appList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-app-del]');
    if (!btn) return;
    removeApplication(btn.dataset.appDel!);
    renderApps();
  });

  renderEvidence();
  renderApps();
</script>
