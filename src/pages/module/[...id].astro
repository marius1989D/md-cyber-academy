---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RungGauge from '../../components/RungGauge.astro';
import { COURSES } from '../../content.config';

export async function getStaticPaths() {
  const modules = (await getCollection('modules', ({ data }) => data.published)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return modules.map((entry) => {
    const siblings = modules.filter((m) => m.data.course === entry.data.course);
    const i = siblings.findIndex((m) => m.id === entry.id);
    return {
      params: { id: entry.id },
      props: { entry, prev: siblings[i - 1], next: siblings[i + 1] },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const course = COURSES[entry.data.course];
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article data-module={entry.id}>
    <!-- ── Header ──────────────────────────────────────────────── -->
    <header class="border-b pb-6">
      <p class="eyebrow">
        <a href={`/courses/#${entry.data.course}`} class="hover:underline">{course.name}</a>
        <span class="mx-1.5" aria-hidden="true">›</span>
        Module {entry.data.order}
      </p>

      <h1 class="mt-2 text-[clamp(1.75rem,1.3rem+2vw,2.6rem)]">{entry.data.title}</h1>
      <p class="mt-3 max-w-[60ch] text-[1.02rem]" style="color: var(--text-2)">
        {entry.data.summary}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <RungGauge rung={entry.data.rung} />
        <span class="font-mono text-[0.7rem]" style="color: var(--text-3)">
          ~{entry.data.minutes} min
        </span>
        <span class="font-mono text-[0.7rem]" style="color: var(--text-3)" data-module-score></span>
      </div>

      {(entry.data.attack.length > 0 || entry.data.atlas.length > 0 || entry.data.objectives.length > 0) && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {[...entry.data.attack, ...entry.data.atlas, ...entry.data.objectives].map((ref) => (
            <span
              class="rounded border px-2 py-0.5 font-mono text-[0.65rem]"
              style="border-color: var(--rule); color: var(--text-3); background: var(--surface-2)"
            >
              {ref}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="lg:flex lg:gap-12">
      <!-- ── Body ──────────────────────────────────────────────── -->
      <div class="prose-md min-w-0 flex-1 pt-8" data-pagefind-body>
        <Content />
      </div>

      <!-- ── Sticky section index (desktop only) ────────────────── -->
      {sections.length > 2 && (
        <aside class="hidden w-[190px] shrink-0 pt-10 xl:block">
          <div class="sticky top-10">
            <p class="eyebrow border-b pb-2">On this page</p>
            <ul class="mt-3 space-y-2">
              {sections.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="block text-[0.78rem] leading-snug hover:underline"
                    style="color: var(--text-3)"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>

    <!-- ── Notes ───────────────────────────────────────────────── -->
    <section class="mt-14">
      <label class="eyebrow block" for="note">// Your notes</label>
      <textarea
        id="note"
        rows="3"
        placeholder="Anything you want waiting for you next time you open this module."
        class="mt-2 w-full resize-y rounded-lg border p-3 text-[0.92rem]"
        style="background: var(--surface-2); border-color: var(--rule); color: var(--text)"
      ></textarea>
      <p class="mt-1.5 font-mono text-[0.65rem]" style="color: var(--text-3)" data-note-status>
        Saved automatically
      </p>
    </section>

    <!-- ── Pager ───────────────────────────────────────────────── -->
    <nav class="mt-12 flex flex-wrap gap-3 border-t pt-6">
      {prev ? (
        <a href={`/module/${prev.id}/`} class="btn">← {prev.data.title}</a>
      ) : (
        <span></span>
      )}
      <a href="/courses/" class="btn">All courses</a>
      {next && <a href={`/module/${next.id}/`} class="btn btn-accent ml-auto">{next.data.title} →</a>}
    </nav>
  </article>
</Base>

<script>
  import { markVisited, saveNote, load, moduleScore } from '../../lib/store';

  const article = document.querySelector<HTMLElement>('[data-module]');
  if (article) {
    const mid = article.dataset.module!;
    markVisited(mid);

    const score = moduleScore(mid);
    const el = article.querySelector<HTMLElement>('[data-module-score]');
    if (el && score.answered > 0) {
      el.textContent = `${score.correct}/${score.answered} correct`;
    }

    const note = article.querySelector<HTMLTextAreaElement>('#note')!;
    const status = article.querySelector<HTMLElement>('[data-note-status]')!;
    note.value = load().notes[mid]?.text ?? '';

    let t: ReturnType<typeof setTimeout>;
    note.addEventListener('input', () => {
      clearTimeout(t);
      status.textContent = 'Saving…';
      t = setTimeout(() => {
        saveNote(mid, note.value);
        status.textContent = `Saved ${new Date().toLocaleTimeString('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
        })}`;
      }, 600);
    });
  }
</script>
