---
import Base from '../layouts/Base.astro';
import RungGauge from '../components/RungGauge.astro';
import { getCollection } from 'astro:content';
import { COURSES, RUNGS, type CourseId } from '../content.config';

const all = (await getCollection('modules', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

const courses = (Object.keys(COURSES) as CourseId[])
  .map((id) => ({ id, ...COURSES[id], modules: all.filter((m) => m.data.course === id) }))
  .filter((c) => c.modules.length > 0);

const totalMinutes = all.reduce((sum, m) => sum + m.data.minutes, 0);
---

<Base title="Home">
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="max-w-[46ch]">
    <p class="eyebrow">// MD Cyber Academy</p>
    <h1 class="mt-3 text-[clamp(2.1rem,1.4rem+3.4vw,3.6rem)]">
      Study to the depth<br />the work demands.
    </h1>
    <p class="mt-5 text-[1.05rem] leading-relaxed" style="color: var(--text-2)">
      {all.length} modules across {courses.length} courses. Every one carries a rung, so you always know
      whether a topic is still definitions or has been taken through to something you have
      actually done.
    </p>
  </section>

  <!-- Resume — the fastest path back in, so it sits above everything else. -->
  <a
    href="#"
    class="panel mt-8 hidden items-center gap-4 p-4 transition hover:border-[var(--accent)]"
    data-resume
  >
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full text-lg" style="background: var(--accent); color:#fff">↩</span>
    <span class="min-w-0">
      <span class="eyebrow block">Pick up where you left off</span>
      <span class="mt-0.5 block truncate font-display font-bold" data-resume-title></span>
    </span>
  </a>

  <!-- ── The ladder ────────────────────────────────────────────── -->
  <section class="mt-14">
    <h2 class="eyebrow border-b pb-2">// The depth ladder</h2>
    <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {([1, 2, 3, 4] as const).map((r) => (
        <li class="panel p-4">
          <RungGauge rung={r} showLabel={false} size="sm" />
          <p class="mt-3 font-display text-[1.05rem] font-bold">{RUNGS[r].label}</p>
          <p class="mt-1 text-[0.86rem] leading-snug" style="color: var(--text-3)">
            {RUNGS[r].blurb}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Courses ───────────────────────────────────────────────── -->
  <section class="mt-14">
    <div class="flex items-baseline justify-between border-b pb-2">
      <h2 class="eyebrow">// Courses</h2>
      <p class="font-mono text-[0.65rem]" style="color: var(--text-3)">
        ~{Math.round(totalMinutes / 60)} hours of material
      </p>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {courses.map((course) => {
        const deepest = Math.max(...course.modules.map((m) => m.data.rung)) as 1 | 2 | 3 | 4;
        return (
          <a
            href={`/courses/#${course.id}`}
            class="panel group flex flex-col p-5 transition hover:border-[var(--accent)]"
          >
            <div class="flex items-start gap-3">
              <span class="text-xl leading-none" aria-hidden="true">{course.icon}</span>
              <h3 class="flex-1 text-[1.08rem] leading-tight group-hover:text-[var(--accent)]">
                {course.name}
              </h3>
            </div>
            <p class="mt-2.5 flex-1 text-[0.9rem] leading-snug" style="color: var(--text-3)">
              {course.blurb}
            </p>
            <div class="mt-4 flex items-center justify-between border-t pt-3">
              <RungGauge rung={deepest} size="sm" />
              <span class="font-mono text-[0.68rem]" style="color: var(--text-3)">
                {course.modules.length} modules
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<script>
  import { load } from '../lib/store';

  const state = load();
  const card = document.querySelector<HTMLAnchorElement>('[data-resume]');
  if (card && state.lastModule) {
    card.href = `/module/${state.lastModule}/`;
    card.querySelector('[data-resume-title]')!.textContent = state.lastModule
      .split('/')
      .pop()!
      .replace(/^\d+-/, '')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
    card.classList.remove('hidden');
    card.classList.add('flex');
  }
</script>
